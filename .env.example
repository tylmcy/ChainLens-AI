# ChainLens AI 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交。

# ---- AI 模型（默认关闭；按需改为 deepseek / transformers）----
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Ethereum RPC（只读节点；默认指向本机 Anvil）----
ETH_RPC_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=31337

# ---- PostgreSQL（Docker Compose 会使用同名变量）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chainlens
POSTGRES_USER=chainlens
POSTGRES_PASSWORD=chainlens

# ---- 本地端口（端口冲突时可改，如 CHAINLENS_PORT=18080）----
CHAINLENS_PORT=8080
ANVIL_PORT=8545

# ---- MCP（本机默认只监听回环；容器显式监听 0.0.0.0）----
SERVER_ADDRESS=127.0.0.1
# 可选 Bearer Token；留空时不启用认证，禁止把真实值提交到 Git。
CHAINLENS_MCP_TOKEN=

# ---- 可观测（可选 OTLP 导出）----
OTEL_EXPORTER_OTLP_ENDPOINT=
