# ChainLens AI 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交。

# ---- LLM（DeepSeek 默认；Provider 可通过 profile 切换）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Ethereum RPC（只读节点；默认指向本机 Anvil）----
ETH_RPC_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=31337

# ---- PostgreSQL（Docker Compose 会使用同名变量）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chainlens
POSTGRES_USER=chainlens
POSTGRES_PASSWORD=chainlens

# ---- MCP（可选，留空则仅本机回环）----
MCP_AUTH_TOKEN=

# ---- 可观测（可选 OTLP 导出）----
OTEL_EXPORTER_OTLP_ENDPOINT=
