<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.chainlens</groupId>
    <artifactId>chainlens-parent</artifactId>
  <version>1.0.0</version>
  </parent>
  <artifactId>chainlens-app</artifactId>
  <name>ChainLens App</name>
  <description>装配与启动模块（Boot 主类、配置、Dockerfile、web 静态产物）</description>

  <dependencies>
    <dependency>
      <groupId>io.chainlens</groupId>
      <artifactId>chainlens-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.chainlens</groupId>
      <artifactId>chainlens-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.chainlens</groupId>
      <artifactId>chainlens-evaluation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- 可观测指标端点（设计文档 2.6：/actuator/metrics 暴露 tool calls 等指标） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 全链路演示测试：WireMock 模拟 RPC 节点 -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- 默认 Java 生命周期不调用 Node；仅显式 -Pweb 时把前端放进同一个 Boot jar。 -->
  <profiles>
    <profile>
      <id>web</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.4</version>
            <executions>
              <execution>
                <id>web-install</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>pnpm</executable>
                  <workingDirectory>${project.basedir}/../web</workingDirectory>
                  <arguments><argument>install</argument><argument>--frozen-lockfile</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>web-typecheck</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>pnpm</executable>
                  <workingDirectory>${project.basedir}/../web</workingDirectory>
                  <arguments><argument>typecheck</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>web-test</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>pnpm</executable>
                  <workingDirectory>${project.basedir}/../web</workingDirectory>
                  <arguments><argument>test</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>web-build</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>pnpm</executable>
                  <workingDirectory>${project.basedir}/../web</workingDirectory>
                  <arguments><argument>build</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>copy-web-assets</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/../web/dist</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
